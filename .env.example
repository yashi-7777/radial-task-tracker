# Copy to .env (never commit .env). Only the server reads these; nothing here reaches the browser.

# Required for AI analysis + the assistant. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: model id (default claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Port the server listens on
PORT=8787

# If the web app is hosted elsewhere (e.g. GitHub Pages), list its origin(s), comma separated.
# Example: ALLOWED_ORIGINS=https://yashi-7777.github.io
ALLOWED_ORIGINS=

# Strongly recommended when the server is reachable from the internet: a long random string.
# The planner asks for it once (Connection settings) and sends it as a Bearer token.
ACCESS_TOKEN=

# Limits (optional)
MAX_UPLOAD_MB=10
AI_LIMIT_PER_10MIN=30
PARSE_LIMIT_PER_10MIN=60
# Set to 1 if running behind a reverse proxy (Render, Railway, nginx) so rate limits use the real client IP
TRUST_PROXY=0
